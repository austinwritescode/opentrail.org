# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/opentrail?schema=public"

# Elevation lookups when creating markers or changing their locations.
GOOGLE_MAPS_API_KEY=""

# S3-compatible (Cloudflare R2) image storage.
S3_ENDPOINT=""
S3_ACCESS_ID=""
S3_SECRET_KEY=""

# Server-side key used by moderation routes.
MOD_KEY=""

# Cloudflare cache invalidation after data changes. Purging is skipped when these are absent.
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# Base URL used to build cache-purge URLs. Defaults to https://opentrail.org.
SITE_URL="https://opentrail.org"

# Set to "true" only on the staging deployment. Drives the DEV STAGING banner and the Sentry environment.
PUBLIC_IS_STAGING=""

# Tile source template used by the PMTiles generation utility.
TILE_URL=""

# Build-time auth for Sentry releases and source-map uploads (used by CI).
# The Sentry build plugin also reads this from .env.sentry-build-plugin.
SENTRY_AUTH_TOKEN=""
